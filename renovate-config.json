{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "prTitle": "[Renovate-bot] {{depName}}: Update to {{newVersion}}",
  "platform": "github",
  "username": "renovate-release",
  "commitAuthor": "Renovate bot",
  "labels": ["dependencies"],
  "repositories": [
    "Pagnet/mfe-suppliers-bureau"
  ],
  "automerge": false,
  "packageRules": [
    {
      "packagePatterns": ["^@useblu/"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
