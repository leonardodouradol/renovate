{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "skipInstalls": true,
  "commitMessage": "[Renovate-bot] {{depName}}: Update to {{newVersion}}",
  "platform": "github",
  "username": "renovate-release",
  "labels": ["dependencies"],
  "repositories": [
    "leonardodouradol/renovate"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    },
    {
      "matchFiles": ["package-lock.json"],
      "enabled": false
    }
  ]
}
