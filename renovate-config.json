{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "platform": "github",
  "username": "renovate-release",
  "labels": ["dependencies"],
  "repositories": [
    "leonardodouradol/renovate"
  ],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1,
  "automerge": false,
  "branchPrefix": "renovate/",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPaths": ["**/package-lock.json"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@useblu/blu-lytics",
        "@useblu/ocean-react",
        "@useblu/ocean-icons-react",
        "@useblu/ocean-core",
        "@useblu/utils",
        "@useblu/ocean-tokens",
        "@useblu/ocean-icons"
      ],
      "groupName": "all-dependencies",
      "commitMessage": "[Renovate-bot] Update all @useblu dependencies",
      "allowedVersions": "/.*/",
      "enabled": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/package-lock.json"
  ],
  "ignoreDeps": [
    "package-lock.json"
  ],
  "postUpgradeTasks": [
    {
      "command": "git checkout -- package-lock.json"
    }
  ],
  "allowedCommands": ["yarn install --frozen-lockfile"],
  "semanticCommits": "enabled",
  "fileFilters": ["package.json", "yarn.lock"]
}
