{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "automerge": false,
  "binarySource": "docker",
  "ignorePaths": [
    "package-lock.json",
    "**/package-lock.json"
  ],
  "enabledManagers": ["yarn"],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    }
  ]
}
