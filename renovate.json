{
   "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "automerge": false,
  "ignorePaths": ["package-lock.json", "**/package-lock.json"],
  "npm": { 
    "enabled": false
  },
  "enabledManagers": ["yarn"],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    }
  ]
}
