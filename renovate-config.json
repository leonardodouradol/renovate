{
    "extends": [
        ":disableDependencyDashboard"
      ],
    "prTitle": "[Renovate-bot] {{depName}}: Update to {{newVersion}}",
    "platform": "github",
    "username": "renovate-release",
    "commitAuthor": "Renovate bot",
    "labels": ["dependencies"],
    "repositories": [
        "leonardodouradol/renovate"
    ],
 "packageRules": [
    {
      "matchPackageNames": ["@useblu/*"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
  }
