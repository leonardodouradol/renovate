{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "automerge": false,
  "skipInstalls": true,
  "ignorePaths": ["package-lock.json", "**/package-lock.json"],
  "postUpdateOptions": ["yarnDedupeHighest"],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    },
    {
      "matchFiles": ["package-lock.json"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  }
}
