{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "prTitle": "[Renovate-bot] Update dependencies",
  "platform": "github",
  "username": "renovate-release",
  "commitAuthor": "Renovate bot",
  "labels": ["dependencies"],
  "repositories": [
    "leonardodouradol/renovate"
  ],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1,
  "automerge": false,
  "branchPrefix": "renovate/",
  "prCreation": "not-pending",
  "recreateClosed": true,
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@useblu/blu-lytics",
        "@useblu/ocean-react",
        "@useblu/ocean-icons-react",
        "@useblu/ocean-core",
        "@useblu/utils",
        "@useblu/ocean-tokens",
        "@useblu/ocean-icons"
      ],
      "groupName": "all-dependencies",
      "commitMessageSuffix": " - grouped updates",
      "prTitle": "[Renovate-bot] Update all dependencies",
      "allowedVersions": "/.*/",
      "enabled": true
    }
  ],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/build/**"],
  "allowedPostUpgradeCommands": ["yarn install --frozen-lockfile"],
  "semanticCommits": true,
  "fileFilters": ["package.json", "yarn.lock"]
}