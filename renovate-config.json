{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "skipInstalls": true,
  "updateLockFiles": true,
  "platform": "github",
  "username": "renovate-release",
  "labels": ["dependencies"],
  "repositories": [
    "leonardodouradol/renovate"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    }
  ],
  "npmrc": "yarn=true",
  "postUpdateOptions": ["yarnDedupeHighest"]
}
