{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "skipInstalls": true,
  "updateLockFiles": false,
  "platform": "github",
  "username": "renovate-release",
  "labels": ["dependencies"],
  "repositories": [
    "leonardodouradol/renovate"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    },
  ]
   "postUpgradeTasks": {
    "commands": ["yarn install"],
    "executionMode": "update"
  }
}
