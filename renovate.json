{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "automerge": false,
  "ignorePaths": ["package-lock.json"],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    }
  ]
}
