{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "prTitle": "[Renovate-bot] {{depName}}: Update to {{newVersion}}",
  "platform": "github",
  "username": "renovate-release",
  "commitAuthor": "Renovate bot",
  "labels": ["dependencies"],
  "repositories": [
    "leonardodouradol/renovate"
  ],
  "automerge": false,
  "packageRules": [
  {
    "matchPackageNames": [
      "@useblu/blu-lytics",
      "@useblu/ocean-react",
      "@useblu/ocean-icons-react",
      "@useblu/ocean-core",
      "@useblu/utils",
      "@useblu/ocean-tokens",
      "@useblu/ocean-icons"
    ],
    "enabled": true
  }
  ]
}
