{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "automerge": false,
  "binarySource": "docker",
  "ignorePaths": [
    "package-lock.json",
    "**/package-lock.json"
  ],
  "hostRules": [
    {
      "matchHost": "github.com",
      "yarn": {
        "force": true
      }
    }
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@useblu/blu-lytics"],
      "groupName": "Blu Lytics Updates",
      "enabled": true
    }
  ]
}
